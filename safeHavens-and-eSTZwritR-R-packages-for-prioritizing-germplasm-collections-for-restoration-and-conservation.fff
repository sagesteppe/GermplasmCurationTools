\begin{figure}
\centering
\pandocbounded{\includegraphics[keepaspectratio,alt={Summary of predictor variable selection and estimated effects across Bayesian habitat suitability models for 52 species. (A) Number of species for which each variable was retained as a predictor following forward feature selection. (B) Median rank of each variable by absolute posterior mean coefficient (\textbar β\textbar) within each species model, with interquartile range shown; rank reflects the directional contribution of each predictor to the linear component of the model. (C) Proportion of species models in which each variable's 95\% credible interval was entirely positive (blue), entirely negative (red), or spanned zero (grey).}]{safeHavens-and-eSTZwritR-R-packages-for-prioritizing-germplasm-collections-for-restoration-and-conservation_files/safeHavens-and-eSTZwritR-R-packages-for-prioritizing-germplasm-collections-for-restoration-and-conservation_files/figure-latex/coef-panel-1.pdf}}
\caption{Summary of predictor variable selection and estimated effects
across Bayesian habitat suitability models for 52 species. (A) Number of
species for which each variable was retained as a predictor following
forward feature selection. (B) Median rank of each variable by absolute
posterior mean coefficient (\textbar β\textbar) within each species
model, with interquartile range shown; rank reflects the directional
contribution of each predictor to the linear component of the model. (C)
Proportion of species models in which each variable's 95\% credible
interval was entirely positive (blue), entirely negative (red), or
spanned zero (grey).}
\end{figure}
